---
layout: base.njk
title: Composer
description: "Write and preview blog drafts."
---

<section class="composer" data-composer-mode="editor" data-can-publish="{% if isProduction %}false{% else %}true{% endif %}">
  <header class="composer-header">
    <div>
      <p class="composer-kicker">Draft</p>
      <h1>New story</h1>
    </div>
    <div class="composer-actions">
      <button class="button secondary-button" type="button" data-copy-markdown>Copy Markdown</button>
      <button class="button secondary-button" type="button" data-open-preview>Preview Page</button>
      {% if not isProduction %}
        <button class="button primary-button" type="button" data-publish>Publish PR</button>
      {% endif %}
    </div>
  </header>

  <div class="composer-layout">
    <aside class="composer-panel">
      <details class="composer-disclosure composer-settings-disclosure">
        <summary>Settings</summary>
        <div class="composer-settings-body">
          <h2>Article</h2>
          <label>
            <span>Slug</span>
            <input type="text" data-field="slug" placeholder="my-article-title">
          </label>
          <label>
            <span>Date</span>
            <input type="date" data-field="date">
          </label>
          <label>
            <span>Tags</span>
            <input type="text" data-field="tags" placeholder="ai, tutorial, transformers">
          </label>
          <label>
            <span>Cover path</span>
            <input type="text" data-field="cover" placeholder="./cover.png">
          </label>
          <label>
            <span>Cover alt</span>
            <input type="text" data-field="coverAlt" placeholder="Cover image description">
          </label>
          <label class="check-row">
            <input type="checkbox" data-field="hideCover">
            <span>Hide cover inside article</span>
          </label>

          <div class="composer-divider"></div>

          <h2>Media</h2>
          <label class="file-drop">
            <span>Upload images or videos</span>
            <input type="file" data-asset-input multiple accept="image/*,video/mp4,video/webm">
          </label>
          <p class="composer-help">Uploaded files are kept in memory until publishing. They are saved next to the article.</p>
          <div class="asset-list" data-asset-list></div>

          <div class="composer-divider"></div>

          {% if not isProduction %}
            <h2>GitHub publish</h2>
            <label>
              <span>Repository</span>
              <input type="text" data-field="repository" value="8bitnand/8bitnand.github.io">
            </label>
            <label>
              <span>Base branch</span>
              <input type="text" data-field="baseBranch" value="main">
            </label>
            <label>
              <span>GitHub token</span>
              <input type="password" data-field="token" placeholder="Fine-grained token">
            </label>
            <label class="check-row">
              <input type="checkbox" data-field="rememberToken">
              <span>Remember token in this browser</span>
            </label>
            <p class="composer-help">Token needs Contents read/write and Pull requests read/write. Publishing creates a branch and PR, not a direct main push.</p>
          {% else %}
            <h2>Preview only</h2>
            <p class="composer-help">Public visitors can draft, copy Markdown, and open the preview page. GitHub publishing is disabled on the public site.</p>
          {% endif %}
          <div class="publish-status" data-publish-status aria-live="polite"></div>
        </div>
      </details>
    </aside>

    <section class="editor-pane">
      <div class="story-head">
        <input class="story-title-input" type="text" data-field="title" placeholder="Article title">
        <textarea class="story-description-input" data-field="description" rows="2" placeholder="Short subtitle / summary for cards, search, and archive"></textarea>
      </div>
      <div class="editor-toolbar" aria-label="Editor tools">
        <button type="button" data-insert="h2">H2</button>
        <button type="button" data-insert="code">Code</button>
        <button type="button" data-insert="image">Image</button>
        <button type="button" data-insert="video">Video</button>
        <button type="button" data-insert="youtube">YouTube</button>
        <button type="button" data-insert="gist">Gist</button>
        <button type="button" data-insert="math">Math</button>
        <button type="button" data-insert="quote">Quote</button>
        <button type="button" data-insert="demo">Demo</button>
        <button type="button" data-insert="table">Table</button>
        <button type="button" data-insert="callout">Callout</button>
      </div>
      <div class="editor-wrap">
        <textarea data-editor hidden aria-hidden="true"></textarea>
        <div class="block-editor article-content" data-block-editor aria-label="Article body"></div>
        <div class="slash-menu" data-slash-menu hidden></div>
      </div>
    </section>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/markdown-it@14.1.0/dist/markdown-it.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js" defer></script>
<script src="/assets/js/composer.js" defer></script>
