---
layout: base.njk
---
<article class="article">
  <header class="article-hero{% if hideCover or not (cover and (cover | assetExists(page.inputPath)) ) %} article-hero--no-cover{% endif %}">
    <div class="eyebrow">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      <span>{{ content | readingTime }} min read</span>
    </div>
    <h1>{{ title }}</h1>
  </header>

  {% if not hideCover and cover and (cover | assetExists(page.inputPath)) %}
    <img class="article-cover" src="{{ cover }}" alt="{{ coverAlt or title }}">
  {% endif %}

  <div class="article-shell">
    <div class="article-content">
      {{ content | safe }}
    </div>
  </div>

  {% if tags %}
    <footer class="article-tags" aria-label="Article tags">
      {% for tag in tags %}
        {% if tag != "posts" %}
          <a class="tag" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>
        {% endif %}
      {% endfor %}
    </footer>
  {% endif %}
</article>

{% set related = collections.posts | relatedPosts(page.url, tags) %}
{% if related.length %}
  <section class="content-section related-section" aria-labelledby="related-heading">
    <div class="section-heading">
      <h2 id="related-heading">Related Articles</h2>
      <p>More notes connected to this topic.</p>
    </div>
    <div class="card-grid compact-grid">
      {% for post in related %}
        <article class="post-card">
          {% if post.data.cover and (post.data.cover | assetExists(post.inputPath)) %}
            <a href="{{ post.url }}" class="card-media">
              <img src="{{ post.url }}{{ post.data.cover | replace('./', '') }}" alt="{{ post.data.coverAlt or post.data.title }}">
            </a>
          {% endif %}
          <div class="card-body">
            <div class="card-meta">
              <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
              <span>{{ post.templateContent | readingTime }} min read</span>
            </div>
            <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <p>{{ post.data.description }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}
