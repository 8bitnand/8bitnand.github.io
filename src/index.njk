---
layout: base.njk
title: Home
---
{% set posts = collections.posts %}

<section class="content-section" aria-labelledby="latest-heading">
  <div class="section-heading">
    <h2 id="latest-heading">Latest Articles</h2>
    <p>Browse all notes, tutorials, and experiments.</p>
  </div>
  <div class="card-grid">
    {% for post in posts %}
      <article class="post-card" data-post-card data-title="{{ post.data.title | lower }}" data-tags="{{ post.data.tags | join(' ') | lower }}">
        {% if post.data.cover and (post.data.cover | assetExists(post.inputPath)) %}
          <a href="{{ post.url }}" class="card-media">
            <img src="{{ post.url }}{{ post.data.cover | replace('./', '') }}" alt="{{ post.data.coverAlt or post.data.title }}">
          </a>
        {% endif %}
        <div class="card-body">
          <div class="card-meta">
            <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
            <span>{{ post.templateContent | readingTime }} min read</span>
          </div>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.description }}</p>
          <div class="tag-row">
            {% for tag in post.data.tags %}
              {% if tag != "posts" %}
                <a class="tag" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</section>
